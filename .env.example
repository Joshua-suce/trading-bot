# =============================================================================
# Binance Futures Trading Bot — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Required for trade mode: API key, secret, and Binance Futures API URL
# Optional: All others have sensible defaults
# =============================================================================

# --- Binance API Credentials ------------------------------------------------
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_API_KEY_FILE=          # Optional secret file path, used if BINANCE_API_KEY is empty
BINANCE_API_SECRET_FILE=       # Optional secret file path, used if BINANCE_API_SECRET is empty
BINANCE_API_URL=https://demo-fapi.binance.com # Demo; use https://fapi.binance.com for mainnet
ALLOW_MAINNET_TRADING=false   # One-time safety authorization for mainnet orders
EXCHANGE_REQUEST_TIMEOUT_MS=30000 # Per-request timeout for Binance API calls
EXCHANGE_CONNECT_ATTEMPTS=3   # Retry transient startup connectivity failures
EXCHANGE_CONNECT_BACKOFF_SECONDS=2 # Linear delay multiplier between attempts
EXCHANGE_READ_ATTEMPTS=3      # Retry idempotent runtime API reads
EXCHANGE_READ_BACKOFF_SECONDS=1 # Linear delay multiplier between read attempts
EXCHANGE_DNS_CACHE_TTL=300     # DNS cache TTL in seconds (30-86400)
EXCHANGE_CONNECTION_LIMIT=20   # Max total concurrent aiohttp connections (1-100)
EXCHANGE_CONNECTION_LIMIT_PER_HOST=10 # Max connections per host (1-50)
EXCHANGE_KEEPALIVE_SECONDS=30  # TCP keepalive timeout (10-300)
EXCHANGE_WS_RECONNECT_JITTER=5.0 # WS reconnect jitter in seconds (0-30)

# --- Trading Configuration --------------------------------------------------
SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT # Comma-separated list of trading pairs
TIMEFRAMES=1m,3m,5m,15m,30m,1h,4h,1d # 1m/3m are isolated scalp scopes
DISABLED_STRATEGY_SCOPES=       # Optional SYMBOL:timeframe scopes blocked after review
POSITION_SCOPE=symbol          # Required: one reconciled position per symbol
SCAN_SLEEP_SECONDS=5           # Scheduler idle sleep between due-scan checks
CANDLE_CLOSE_GRACE_SECONDS=2   # Delay after UTC candle boundary before fetching
ACCOUNT_BALANCE_CACHE_SECONDS=10 # Reuse the authenticated startup snapshot briefly
ACCOUNT_REFRESH_INTERVAL_SECONDS=60 # Private account snapshot cadence
RECONCILIATION_INTERVAL_SECONDS=30 # Fast cleanup of completed leg protection
RECONCILIATION_ALERT_FAILURE_THRESHOLD=3 # Alert after repeated transient outages
CLOCK_SYNC_INTERVAL_SECONDS=60 # Proactive Binance clock resync every minute
RECONCILIATION_SETTLEMENT_ATTEMPTS=3 # Retry transient position/order visibility races
RECONCILIATION_SETTLEMENT_BACKOFF_SECONDS=1 # Linear delay between settlement reads
PROTECTION_EXECUTION_MATCH_BPS=10 # Max fallback fill distance from audited SL/TP
AUTO_CLOSE_UNMANAGED_POSITIONS=true # Flatten exposure not represented in the audit store
MIN_OHLCV_CANDLES=200          # EMA 200 warm-up before indicators/signals are allowed
MAX_CANDLE_DELAY_MULTIPLIER=3.0 # Reject stale candles older than timeframe * multiplier
ALLOW_ZERO_VOLUME_CANDLES=false # Reject zero-volume candles by default
MAX_ENTRY_SLIPPAGE_BPS=45       # Block entry market orders above this bid/ask slippage; raised from 25 to reduce false rejections
ENTRY_FILL_RESOLUTION_ATTEMPTS=5 # Retry delayed Binance execution-ledger fills
ENTRY_FILL_RESOLUTION_BACKOFF_SECONDS=0.5 # Linear delay between fill lookups
REENTRY_COOLDOWN_SECONDS=900    # Per-symbol cooldown after any completed trade
MIN_ORDER_NOTIONAL=5            # Minimum notional after exchange precision normalization
MAX_LEVERAGE=3                 # Maximum leverage (1-20 policy cap, exchange limits apply)
MAX_POSITION_SIZE=0.02         # Max fraction of equity per position (0.02 = 2%)
MAX_OPEN_POSITIONS=6           # Max simultaneous audited trade legs
MAX_POSITIONS_PER_SYMBOL=1     # One aggregate Binance position per symbol
MAX_TOTAL_OPEN_NOTIONAL_PCT=0.20 # Max total open notional as fraction of equity
MAX_SYMBOL_OPEN_NOTIONAL_PCT=0.10 # Max per-symbol open notional as fraction of equity
CORRELATED_SYMBOLS=BTCUSDT,ETHUSDT,BNBUSDT # Assets sharing one directional risk budget
MAX_CORRELATED_OPEN_NOTIONAL_PCT=0.15 # Same-side correlated notional cap
MAX_UNFAVORABLE_FUNDING_RATE=0.001 # Block entries paying more than 10bps per funding period
MARKET_DEPTH_LEVELS=20 # Order-book levels used for fill-impact estimates
MAX_MARKET_DEPTH_SLIPPAGE_BPS=25 # Maximum estimated depth impact
SCALP_MAX_MARKET_DEPTH_SLIPPAGE_BPS=5 # Stricter scalp depth-impact cap
ADAPTIVE_LIMIT_ENTRY_ENABLED=true # Use passive entries for non-urgent strategies
LIMIT_ENTRY_TIMEOUT_SECONDS=3 # Wait briefly for a passive fill
LIMIT_ENTRY_POLL_SECONDS=0.5 # Passive order status cadence
LIMIT_ENTRY_MARKET_FALLBACK=true # Fall back after cancelling an unfilled passive order
DAILY_LOSS_LIMIT=0.05          # Max daily loss as fraction of equity (0.05 = 5%)
MAX_DRAWDOWN=0.15              # Max drawdown before stopping (0.15 = 15%)
RISK_PER_TRADE=0.01            # Fraction of equity risked per trade (0.01 = 1%)
MIN_CONFIDENCE=0.45            # Minimum aligned TA/ML signal confidence
STRATEGY_TREND_MIN_CONFIDENCE=0.45 # Minimum confidence for established trends
STRATEGY_TRANSITION_MIN_CONFIDENCE=0.50 # Minimum confidence for emerging trends
STRATEGY_RANGE_MIN_CONFIDENCE=0.50 # Minimum confidence for range mean reversion
STRATEGY_BREAKOUT_MIN_CONFIDENCE=0.55 # Minimum confidence for breakout entries
STRATEGY_REVERSAL_MIN_CONFIDENCE=0.60 # Minimum confidence for confirmed reversals
STRATEGY_COUNTERTREND_MIN_CONFIDENCE=0.65 # Defensive floor; quality gate blocks unconfirmed countertrend
STRATEGY_SCALP_MIN_CONFIDENCE=0.60 # Minimum confirmed 1m/3m scalp confidence
STRATEGY_TREND_RISK_PER_TRADE=0.005 # Independent trend risk budget
STRATEGY_TRANSITION_RISK_PER_TRADE=0.004 # Emerging-trend risk budget
STRATEGY_RANGE_RISK_PER_TRADE=0.004 # Mean-reversion risk budget
STRATEGY_BREAKOUT_RISK_PER_TRADE=0.004 # Breakout risk budget
STRATEGY_REVERSAL_RISK_PER_TRADE=0.003 # Confirmed reversal risk budget
STRATEGY_COUNTERTREND_RISK_PER_TRADE=0.0025 # Defensive risk budget
STRATEGY_MIN_NET_EDGE_BPS=12.0 # Required target edge after fees and spread
STRATEGY_MAX_SPREAD_BPS=12.0 # Non-scalp two-sided quote limit
STRATEGY_MAX_CONSECUTIVE_LOSSES=3 # Per-strategy loss circuit breaker
STRATEGY_LOSS_COOLDOWN_SECONDS=1800 # Per-strategy retry delay
ML_CONFIDENCE_THRESHOLD=0.55   # Reserved: no ML model is wired into live trading yet, so this has no effect
REQUIRE_SIGNAL_CONFLUENCE=false # Must stay false: live trading is TA-only; true fails preflight (see src/preflight.py)
STRATEGY_QUALITY_MIN_SCORE=0.68 # Minimum regime/momentum quality score
STRATEGY_MIN_ADX=18             # Avoid directionless market regimes
STRATEGY_MIN_VOLUME_RATIO=0.70  # Require reasonable market participation
STRATEGY_MIN_ATR_PCT=0.0005     # Reject extremely inactive markets
STRATEGY_MAX_ATR_PCT=0.025      # Reject disorderly volatility
STRATEGY_MAX_EMA_EXTENSION_ATR=2.0 # Avoid chasing price far from EMA 50
STRATEGY_RANGE_MAX_ADX=25       # Highest ADX treated as range-bound
STRATEGY_REVERSAL_MIN_SCORE=0.75 # Stronger confirmation for reversals
STRATEGY_BREAKOUT_MIN_VOLUME_RATIO=1.0 # Minimum breakout volume participation
STRATEGY_BREAKOUT_MAX_EXTENSION_ATR=3.0 # Hard cap against chasing extended breakouts
STRATEGY_BREAKOUT_MIN_BODY_RATIO=0.50 # Minimum breakout candle body/range
STRATEGY_BREAKOUT_MIN_CLOSE_LOCATION=0.75 # Bull close location; mirrored for shorts
STRATEGY_REJECTION_MIN_WICK_RATIO=0.25 # Range/reversal rejection wick requirement
WALK_FORWARD_MIN_TRADES=30 # Minimum OOS trades per strategy scope
WALK_FORWARD_MAX_DRAWDOWN_PCT=15.0 # Maximum OOS drawdown for promotion
SCALP_RISK_PER_TRADE=0.003 # Lower account risk per scalp
SCALP_ATR_STOP_MULTIPLIER=0.80 # Tight volatility-aware scalp stop
SCALP_RISK_REWARD_RATIO=1.50 # Scalp target relative to stop distance
SCALP_MIN_STOP_LOSS_PCT=0.0015 # 15bps minimum scalp stop
SCALP_MAX_STOP_LOSS_PCT=0.006 # 60bps maximum scalp stop
SCALP_MAX_SPREAD_BPS=4.0 # Block scalps in wide markets
SCALP_MAX_ENTRY_SLIPPAGE_BPS=5.0 # Strict signal-to-fill drift cap for scalps
SCALP_ESTIMATED_ROUND_TRIP_FEE_BPS=8.0 # Mainnet round trip; demo applies 2x
SCALP_MIN_NET_EDGE_BPS=15.0 # Required target edge after spread and fees
SCALP_REENTRY_COOLDOWN_SECONDS=60 # Faster but bounded scalp re-entry
SCALP_WEBSOCKET_ENABLED=true # Stream closed 1m/3m candles with REST fallback
SCALP_DEMO_WEBSOCKET_ENABLED=false # Demo defaults to prioritized REST fast lane
SCALP_STREAM_FALLBACK_SECONDS=20 # Use REST when a scalp stream is stale
SCALP_MAX_SIGNAL_LATENCY_SECONDS=12 # Reject stale closed-candle scalp entries
SCALP_REST_MAX_SIGNAL_LATENCY_SECONDS=45 # Wider bound for REST fallback candles
SCALP_REST_CANDLE_CLOSE_GRACE_SECONDS=15 # Wait for REST to publish a newly closed scalp candle
SCALP_REST_FRESHNESS_ATTEMPTS=3 # Refetch delayed demo scalp candles before rejecting
SCALP_REST_FRESHNESS_RETRY_SECONDS=5 # Delay between bounded freshness refetches
SCALP_STREAM_FAILURE_THRESHOLD=3 # Open stream circuit after repeated failures
SCALP_STREAM_CIRCUIT_SECONDS=900 # REST-only cooldown before reconnecting
MARKET_DATA_CONCURRENCY=4 # Bounded concurrent market-data workers
CANDLE_CACHE_SIZE=350 # Rolling candles retained per symbol/timeframe
SCALP_MANAGEMENT_INTERVAL_SECONDS=2 # Open scalp management cadence
SCALP_MAX_HOLD_SECONDS_1M=900 # Time exit for 1m scalp positions
SCALP_MAX_HOLD_SECONDS_3M=1800 # Time exit for 3m scalp positions
SCALP_BREAK_EVEN_TRIGGER_R=0.75 # Move stop after this favorable R multiple
SCALP_BREAK_EVEN_OFFSET_BPS=10 # Lock estimated costs beyond entry
SCALP_TRAILING_TRIGGER_R=1.25 # Begin favorable-peak trailing after this R
SCALP_TRAILING_DISTANCE_R=0.75 # Trail distance measured in initial risk
SCALP_STOP_UPDATE_MIN_BPS=2 # Ignore immaterial stop replacements
SCALP_PARTIAL_PROFIT_ENABLED=true # Allow one risk-controlled partial reduction
SCALP_PARTIAL_PROFIT_TRIGGER_R=1.0 # Partial reduction trigger in initial R
SCALP_PARTIAL_PROFIT_FRACTION=0.5 # Fraction reduced at the partial trigger
PERFORMANCE_GOVERNANCE_WINDOW_DAYS=30 # Rolling evidence window
PERFORMANCE_GOVERNANCE_MIN_SIGNALS=30 # Accepted resolved signals before rating
PERFORMANCE_GOVERNANCE_MIN_TRADES=10 # Closed trades before PnL becomes decisive
PERFORMANCE_PROMOTE_MIN_ACCURACY=0.55 # Candidate promotion accuracy floor
PERFORMANCE_DISABLE_MAX_ACCURACY=0.42 # Candidate disable accuracy ceiling
PERFORMANCE_PROMOTE_MIN_RETURN_BPS=2.0 # Minimum average directional edge
EXECUTION_QUALITY_WINDOW_HOURS=24 # Rolling execution diagnostics window
EXECUTION_QUALITY_MIN_ATTEMPTS=10 # Attempts required before health rating
EXECUTION_QUALITY_WARNING_SLIPPAGE_BPS=20 # Elevated average entry slippage
EXECUTION_QUALITY_CRITICAL_FAILURE_RATE=0.25 # Critical failed-attempt ratio
EXECUTION_QUALITY_WARNING_PROTECTION_LATENCY_MS=5000 # Slow SL/TP placement
MIN_STOP_LOSS_PCT=0.0035       # Prevent noise-tight stops (0.35%)
MAX_STOP_LOSS_PCT=0.02         # Cap per-trade stop distance (2%)
MAX_CONSECUTIVE_LOSSES=3       # Activate the loss-streak circuit breaker
CONSECUTIVE_LOSS_COOLDOWN_SECONDS=1800 # 30-minute automatic recovery
RISK_BLOCK_ALERT_COOLDOWN_SECONDS=900 # Deduplicate repeated risk alerts

# --- ML Model Settings ------------------------------------------------------
AUTO_RETRAIN_ENABLED=false      # Run training outside latency-sensitive trade mode
AUTO_RETRAIN_ON_STARTUP=false   # Keep startup focused on reconciliation and scanning
MODEL_UPDATE_INTERVAL_HOURS=24  # Age at which a model becomes due for retraining
AUTO_RETRAIN_CHECK_INTERVAL_SECONDS=300 # How often to look for due models
AUTO_RETRAIN_CANDLE_LIMIT=1000  # Recent candles used for each training scope
AUTO_RETRAIN_SCOPE_DELAY_SECONDS=2 # Delay between scopes to control API/CPU load
FEATURE_LOOKBACK=100            # Lookback periods for feature engineering
PREDICTION_HORIZON=6            # Prediction horizon in periods
ML_LABEL_ATR_MULTIPLIER=0.50    # Neutral band based on current ATR
ML_LABEL_MIN_RETURN=0.001       # Floor; runtime raises this above fees plus required edge
FORCE_TA_ONLY=false             # Skip ML model loading entirely (TA-only signals)

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO                  # DEBUG, INFO, WARNING, ERROR
LOG_DIR=data/logs               # Directory for log files
JSON_LOGS=true                  # Write structured JSONL logs alongside text logs
AUDIT_DB_PATH=data/audit/trading_audit.db # Durable audit/control database
RUNTIME_HEARTBEAT_PATH=data/runtime/trading_heartbeat.json # Atomic liveness state for supervisor
SUPERVISOR_CHECK_INTERVAL_SECONDS=5
SUPERVISOR_STARTUP_GRACE_SECONDS=180 # Allow model loading and reconciliation
SUPERVISOR_HEARTBEAT_STALE_SECONDS=90
SUPERVISOR_SHUTDOWN_TIMEOUT_SECONDS=30
SUPERVISOR_MAX_RESTARTS_PER_HOUR=10
SUPERVISOR_RESTART_BACKOFF_SECONDS=5
SUPERVISOR_MAX_BACKOFF_SECONDS=60
SUPERVISOR_ALERT_TIMEOUT_SECONDS=20 # Hard cap on the "bot stopped" alert send
ROLLOUT_ARTIFACT_PATH=data/governance/rollout.json
MAINNET_CANARY_ENABLED=true # Keep limited-risk caps after rollout approval
MAINNET_CANARY_RISK_PER_TRADE=0.0025
MAINNET_CANARY_MAX_POSITION_SIZE=0.005
TRADING_ENABLED=true            # Global env-level trading enable/disable switch
REQUIRE_STRATEGY_APPROVAL=true  # Mainnet requires an unexpired approval artifact
STRATEGY_APPROVAL_PATH=data/governance/strategy_approval.json
STRATEGY_APPROVAL_MAX_AGE_HOURS=168
MIN_APPROVAL_TRADES=20
MIN_APPROVAL_PROFIT_FACTOR=1.10
MAX_APPROVAL_DRAWDOWN_PCT=20.0
REQUIRE_WALK_FORWARD_APPROVAL=true
MIN_APPROVAL_OOS_FOLDS=3
MIN_APPROVAL_PROFITABLE_FOLD_RATIO=0.50

# --- Alerts (optional) ------------------------------------------------------
# Telegram: create a bot via @BotFather, get chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_TOKEN_FILE=
TELEGRAM_CHAT_ID_FILE=
TELEGRAM_COMMANDS_ENABLED=false # Enables authorized long-poll admin commands
TELEGRAM_ALLOWED_USER_IDS=      # Numeric user IDs; strongly recommended for groups
TELEGRAM_POLL_TIMEOUT_SECONDS=20
TELEGRAM_ALERT_QUEUE_SIZE=100
TELEGRAM_DELIVERY_TIMEOUT_SECONDS=10
# Discord: create webhook in Server Settings → Integrations
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_URL_FILE=

# --- Model Storage (optional) -----------------------------------------------
MODEL_DIR=data/models           # Directory for saved ML models
