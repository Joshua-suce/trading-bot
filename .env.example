# =============================================================================
# Binance Futures Trading Bot — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Required for trade mode: API key, secret, and Binance Futures API URL
# Optional: All others have sensible defaults
# =============================================================================

# --- Binance API Credentials ------------------------------------------------
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_API_KEY_FILE=          # Optional secret file path, used if BINANCE_API_KEY is empty
BINANCE_API_SECRET_FILE=       # Optional secret file path, used if BINANCE_API_SECRET is empty
BINANCE_API_URL=https://demo-fapi.binance.com # Demo; use https://fapi.binance.com for mainnet
ALLOW_MAINNET_TRADING=false   # One-time safety authorization for mainnet orders
EXCHANGE_REQUEST_TIMEOUT_MS=30000 # Per-request timeout for Binance API calls
EXCHANGE_CONNECT_ATTEMPTS=3   # Retry transient startup connectivity failures
EXCHANGE_CONNECT_BACKOFF_SECONDS=2 # Linear delay multiplier between attempts
EXCHANGE_READ_ATTEMPTS=3      # Retry idempotent runtime API reads
EXCHANGE_READ_BACKOFF_SECONDS=1 # Linear delay multiplier between read attempts

# --- Trading Configuration --------------------------------------------------
SYMBOLS=BTCUSDT,ETHUSDT        # Comma-separated list of trading pairs
TIMEFRAMES=5m,15m,30m,1h,4h,1d # Comma-separated timeframes (1m,5m,15m,30m,1h,4h,1d)
POSITION_SCOPE=symbol          # Required: one reconciled position per symbol
SCAN_SLEEP_SECONDS=5           # Scheduler idle sleep between due-scan checks
ACCOUNT_REFRESH_INTERVAL_SECONDS=60 # Private account snapshot cadence
RECONCILIATION_INTERVAL_SECONDS=300 # Exchange/order reconciliation cadence
MIN_OHLCV_CANDLES=200          # EMA 200 warm-up before indicators/signals are allowed
MAX_CANDLE_DELAY_MULTIPLIER=3.0 # Reject stale candles older than timeframe * multiplier
ALLOW_ZERO_VOLUME_CANDLES=false # Reject zero-volume candles by default
MAX_ENTRY_SLIPPAGE_BPS=25       # Block entry market orders above this bid/ask slippage
REENTRY_COOLDOWN_SECONDS=900    # Per-symbol cooldown after any completed trade
MIN_ORDER_NOTIONAL=5            # Minimum notional after exchange precision normalization
MAX_LEVERAGE=3                 # Maximum leverage (1-20 policy cap, exchange limits apply)
MAX_POSITION_SIZE=0.02         # Max fraction of equity per position (0.02 = 2%)
MAX_OPEN_POSITIONS=3           # Max simultaneous audited open positions
MAX_TOTAL_OPEN_NOTIONAL_PCT=0.20 # Max total open notional as fraction of equity
MAX_SYMBOL_OPEN_NOTIONAL_PCT=0.10 # Max per-symbol open notional as fraction of equity
DAILY_LOSS_LIMIT=0.05          # Max daily loss as fraction of equity (0.05 = 5%)
MAX_DRAWDOWN=0.15              # Max drawdown before stopping (0.15 = 15%)
RISK_PER_TRADE=0.02            # Fraction of equity risked per trade (0.02 = 2%)

# --- ML Model Settings ------------------------------------------------------
MODEL_UPDATE_INTERVAL_HOURS=24  # How often to retrain ML models
FEATURE_LOOKBACK=100            # Lookback periods for feature engineering
PREDICTION_HORIZON=6            # Prediction horizon in periods

# --- Logging ----------------------------------------------------------------
LOG_LEVEL=INFO                  # DEBUG, INFO, WARNING, ERROR
LOG_DIR=data/logs               # Directory for log files
JSON_LOGS=true                  # Write structured JSONL logs alongside text logs
AUDIT_DB_PATH=data/audit/trading_audit.db # Durable audit/control database
TRADING_ENABLED=true            # Global env-level trading enable/disable switch
REQUIRE_STRATEGY_APPROVAL=true  # Mainnet requires an unexpired approval artifact
STRATEGY_APPROVAL_PATH=data/governance/strategy_approval.json
STRATEGY_APPROVAL_MAX_AGE_HOURS=168
MIN_APPROVAL_TRADES=20
MIN_APPROVAL_PROFIT_FACTOR=1.10
MAX_APPROVAL_DRAWDOWN_PCT=20.0

# --- Alerts (optional) ------------------------------------------------------
# Telegram: create a bot via @BotFather, get chat ID via @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_TOKEN_FILE=
TELEGRAM_CHAT_ID_FILE=
TELEGRAM_COMMANDS_ENABLED=false # Enables authorized long-poll admin commands
TELEGRAM_ALLOWED_USER_IDS=      # Numeric user IDs; strongly recommended for groups
TELEGRAM_POLL_TIMEOUT_SECONDS=20
TELEGRAM_ALERT_QUEUE_SIZE=100
TELEGRAM_DELIVERY_TIMEOUT_SECONDS=10
# Discord: create webhook in Server Settings → Integrations
DISCORD_WEBHOOK_URL=
DISCORD_WEBHOOK_URL_FILE=

# --- Model Storage (optional) -----------------------------------------------
MODEL_DIR=data/models           # Directory for saved ML models
